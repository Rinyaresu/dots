#!/usr/bin/env bash
set -euo pipefail

fail() { printf '%s\n' "$*" >&2; exit 1; }

[[ $# == 1 ]] || fail "Usage: $0 {check|apply|rollback}"
case $1 in
  check|apply) target=no ;;
  rollback) target=yes ;;
  *) fail "Usage: $0 {check|apply|rollback}" ;;
esac

[[ $(hostname) == cachyos ]] && grep -qx 'ID=cachyos' /etc/os-release ||
  fail 'This procedure is only for the CachyOS desktop (hostname cachyos).'

wired=1d3b854c-bfff-37ca-8e98-b921591d7c29
wifi=98bdeb46-c25f-4272-ae50-64e93c955429
export LC_ALL=C
profile() { nmcli --get-values "$2" connection show uuid "$1"; }

[[ $(profile "$wired" connection.type,connection.interface-name,connection.autoconnect) == $'802-3-ethernet\nenp7s0\nyes' ]] ||
  fail 'Expected the existing enp7s0 profile with autoconnect=yes; no change made.'
[[ $(profile "$wifi" connection.type,connection.interface-name) == $'802-11-wireless\nwlan0' ]] ||
  fail 'Expected the existing wlan0 profile; no change made.'

if [[ $1 != check && $(profile "$wifi" connection.autoconnect) != "$target" ]]; then
  nmcli connection modify uuid "$wifi" connection.autoconnect "$target"
fi

actual=$(profile "$wifi" connection.autoconnect)
[[ $actual == "$target" ]] || fail "Expected wlan0 autoconnect=$target; got $actual."
printf 'enp7s0 autoconnect=yes; wlan0 autoconnect=%s\n' "$actual"
